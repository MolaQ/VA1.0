# VVA – konfiguracja serwera domowego.
# Nie edytuj ręcznie przy pierwszej instalacji: ./vva.sh setup wypełni ten plik
# (sekrety, domena, tryb HTTPS) i zapisze go jako deploy/.env.

# ---- Tryb dostępu (ustawia vva.sh setup) ---------------------------------
# tunnel = Cloudflare Tunnel (zalecane w domu: bez przekierowania portów)
# caddy  = własny certyfikat Let's Encrypt (porty 80 i 443 przekierowane na ten komputer)
# lan    = tylko sieć domowa, http://IP (test; PWA/instalacja aplikacji nie zadziała)
VVA_MODE=tunnel
APP_DOMAIN=vva.example.pl
SERVER_NAME=:80
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Porty na tym komputerze (zmień, jeśli 80/443 są zajęte, np. przez XAMPP)
HTTP_PORT=80
HTTPS_PORT=443

# ---- Aplikacja -----------------------------------------------------------
APP_NAME=VVA
APP_KEY=
APP_DEBUG=false
APP_URL=https://vva.example.pl
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_MAINTENANCE_DRIVER=file
TZ=Europe/Warsaw

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# ---- Baza danych (MySQL w kontenerze) ------------------------------------
DB_DATABASE=vva
DB_USERNAME=vva
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Sesje, cache, kolejka -----------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Reverb (WebSockets) – klucze generuje vva.sh setup -------------------
REVERB_APP_ID=vva
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ---- Poczta (domyślnie tylko do logu; do resetu haseł ustaw SMTP) ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@vva.example.pl
MAIL_FROM_NAME=VVA

# ---- Moduł AI (opcjonalnie, patrz compose.gpu.example.yml) ----------------
VVA_ANALYZER_URL=
VVA_ANALYZER_TOKEN=
# COMPOSE_FILE=compose.yml:compose.gpu.yml

# ---- Kopie zapasowe ------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
