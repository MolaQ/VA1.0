{
    "name": "VVA – Volleyball Video Analyze",
    "short_name": "VVA",
    "description": "Volleyball match analysis from YouTube video: AI-scouted stats linked to every moment of the recording.",
    "id": "/",
    "start_url": "/dashboard?source=pwa",
    "scope": "/",
    "display": "standalone",
    "display_override": ["window-controls-overlay", "standalone"],
    "orientation": "any",
    "background_color": "#0B1220",
    "theme_color": "#0B1220",
    "lang": "pl",
    "categories": ["sports", "productivity"],
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
        { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
    ],
    "shortcuts": [
        { "name": "Mecze / Matches", "url": "/games", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Zawodnicy / Players", "url": "/players", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
