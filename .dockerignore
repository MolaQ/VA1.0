# Keep the production image clean: no local secrets, no dev artefacts.
.git
.github
.env
.env.*
!.env.example
node_modules
vendor
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
storage/*.key
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/private/*
storage/app/public/*
bootstrap/cache/*.php
database/*.sqlite
deploy/.env
deploy/backups
.phpunit.cache
.idea
.vscode
.claude
